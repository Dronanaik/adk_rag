# Google Gemini / ADK Configuration
GOOGLE_API_KEY=your_google_api_key_here
AGENT_MODEL=gemini-2.5-pro
GRAPH_EXTRACTION_MODEL=gemini-2.5-flash

# Neon Console PostgreSQL (with pgvector extension)
# Example: postgresql://neondb_owner:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# JWT Session Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret-string
JWT_EXPIRE_HOURS=168

# Neo4j Knowledge Graph (AuraDB or Local Neo4j)
# Example AuraDB: neo4j+s://xxxxxxxx.databases.neo4j.io
# Example Local:  bolt://localhost:7687
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Retrieval Configuration
TOP_K=5

# LangSmith Observability & RAG Evaluation (Optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=adk-agentic-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
