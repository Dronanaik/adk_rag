# ==============================================================================
# Agentic RAG System with Centralized Memory and Knowledge Graph
# Environment Variable Template (.env.example)
# Copy to `backend/.env` for local development. NEVER commit real secrets.
# ==============================================================================

# --- Google Gemini & ADK Runtime (Required) ---
GOOGLE_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Supabase PostgreSQL + pgvector (Required) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --- Server-Side Authorization (D-05) ---
ADMIN_API_KEY=dev-admin-key-change-in-production

# --- CORS & HTTP Transport ---
CORS_ORIGINS=http://localhost:5173

# --- Ingestion Pipeline & Chunking Bounds ---
MAX_UPLOAD_SIZE_MB=25
DEFAULT_CHUNK_SIZE_TOKENS=700
DEFAULT_CHUNK_OVERLAP_TOKENS=100
INGESTION_CONCURRENCY=4

# --- Optional Outbound Ingestion Webhook ---
INGESTION_WEBHOOK_URL=
WEBHOOK_SECRET=

